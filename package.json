{
  "name": "plaintext-stopwatch",
  "version": "1.1.0",
  "description": "Add in-text stopwatches that store their state as plain text in your notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "stopwatch",
    "time-tracking"
  ],
  "author": "mbugti04",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
